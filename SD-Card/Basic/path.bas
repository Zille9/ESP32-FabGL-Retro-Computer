10 CLS:DIM X(10),Y(10)
11 FOR I=1 TO 500
14 COL0,(RND(64))
20 FOR J=0 TO 5
30 X(J)=INT(RND(320)):Y(J)=INT(RND(240))
60 NEXT J
65 W=RND(1)
70 IF W=0 THEN PATH X(0),Y(0),X(1),Y(1),X(2),Y(2),X(3),Y(3),X(4),Y(4),X(5),Y(5)
75 ELSE PATHF X(0),Y(0),X(1),Y(1),X(2),Y(2),X(3),Y(3),X(4),Y(4),X(5),Y(5)
80 NEXT I
90 RUN"lines.bas"
