10 CLS:INPUT"Bis zu welcher Zahl";LI
20 IF LI>10000 THEN BEEP:PRINT"MAX-Grenze 10000":PAUSE 2000:GOTO 10
30 DIM S(LI)
40 T=TIMER
50 FOR P=2 TO INT(SQR(LI))
60 IF S(P)=0 THEN GOSUB 180
70 NEXT P
80 PRINT:PRINT"Primzahlen bis ";LI;":"
90 FOR N=2 TO INT(LI)
100 IF S(N)=0 THEN PRINT N;" ";:C=C+1
110 NEXT N
120 PRINT:PRINT:PRINT"Anzahl Primzahlen:";C
130 PRINT:PRINT"Zeit: ";(TIMER-T)/1000;" sek"
140 PRINT:PRINT"Nochmal? j/n";
150 K=INKEY:IF K=0 THEN GOTO 150
160 IF K=ASC("j") THEN RUN
170 ELSE PRINT:END
180 FOR I=P*P TO LI STEP P
190 S(I)=1
200 NEXT I
210 RETURN
