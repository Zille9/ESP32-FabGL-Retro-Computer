10 COL 12,0:CUR0:CLS
20 DIM X(8),Y(8),Z(8),U(8),V(8)
30 D=150:A=0
35 RESTORE
40 FOR I=1 TO 8:READ X(I),Y(I),Z(I):NEXT I
50 DATA -50,-50,-50, 50,-50,-50, 50,50,-50, -50,50,-50
60 DATA -50,-50, 50, 50,-50, 50, 50,50, 50, -50,50, 50
70 S=SIN(A):C=COS(A)
80 FOR I=1 TO 8
90 NX=X(I)*C-Z(I)*S
100 NZ=X(I)*S+Z(I)*C
110 F=D/(D+NZ)
120 U(I)=150+NX*F:V(I)=120+Y(I)*F
130 NEXT I
140 CLS
150 FOR K=1 TO 4
152 L=K+1
155 IF L=5 THEN L=1
160 LINE U(K),V(K),U(L),V(L)
170 LINE U(K+4),V(K+4),U(L+4),V(L+4)
180 LINE U(K),V(K),U(K+4),V(K+4)
190 NEXT K
195 PAUSE 50
200 A=A+0.1:B=B+0.02:GOTO 70
