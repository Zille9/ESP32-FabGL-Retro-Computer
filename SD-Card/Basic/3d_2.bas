10 REM *** 3D WUERFEL ROTATION FUER KC87 ***
20 CLS:PEN 12:CUR 0:REM GRAFIK INITIALISIEREN
30 DIM X(8),Y(8),Z(8),PX(8),PY(8),OX(8),OY(8)
35 RESTORE
40 FOR I=1 TO 8: READ X(I),Y(I),Z(I): NEXT I
50 DATA -45,-45,45,45,-45,45,45,45,45,-45,45,45
60 DATA -45,-45,-45,45,-45,-45,45,45,-45,-45,45,-45
70 WA=0:WB=0:D=180:CX=150:CY=120
80 REM
90 SA=SIN(WA):CA=COS(WA):SB=SIN(WB):CB=COS(WB)
100 FOR I=1 TO 8
110 REM DOPPEL-ROTATION X & Y
120 YR=(Y(I)*CA)-(Z(I)*SA):ZR=(Y(I)*SA)+(Z(I)*CA)
130 XR=(X(I)*CB)-(ZR*SB):ZZ=(X(I)*SB)+(ZR*CB)
140 REM PROJEKTION
150 PX(I)=INT(XR*D/(ZZ+D)+CX):PY(I)=INT(YR*D/(ZZ+D)+CY)
160 NEXT I
170 REM --- LOESCHEN & ZEICHNEN ---
180 CLS:REM ALTE LINIEN WEG
190 PEN COL(0):GOSUB 300:REM NEUE LINIEN HER
200 FOR I=1 TO 8
202 AB=PX(I):OX(I)=AB:AB=PY(I):OY(I)=AB
205 NEXT I
210 WA=WA+.15:WB=WB+.1:GOTO 90
300 REM --- SUB: 12 KANTEN ---
320 REM QUADRAT VORNE
330 LINE PX(1),PY(1),PX(2),PY(2):LINE PX(2),PY(2),PX(3),PY(3)
340 LINE PX(3),PY(3),PX(4),PY(4):LINE PX(4),PY(4),PX(1),PY(1)
350 REM QUADRAT HINTEN
360 LINE PX(5),PY(5),PX(6),PY(6):LINE PX(6),PY(6),PX(7),PY(7)
370 LINE PX(7),PY(7),PX(8),PY(8):LINE PX(8),PY(8),PX(5),PY(5)
380 REM VERBINDUNGEN
390 LINE PX(1),PY(1),PX(5),PY(5):LINE PX(2),PY(2),PX(6),PY(6)
400 LINE PX(3),PY(3),PX(7),PY(7):LINE PX(4),PY(4),PX(8),PY(8)
405 PAUSE 25
410 RETURN
