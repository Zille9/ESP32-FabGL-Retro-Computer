10 COL 0,11:CUR0
30 CLS:DIM F(10):F(0)=0:F(1)=1:F(2)=2:F(3)=3:F(4)=6:F(5)=7
32 F(6)=19:F(7)=23:F(8)=27:F(9)=43:F(10)=47
35 REM KAMERA
40 REM KAMERA
50 CX=0:CY=-20:CZ=-200
60 REM KUGEL 1
70 XS=-40:YS=0:ZS=120:RS=40
80 REM KUGEL 2
90 XX=70:TY=-20:ZZ=160:RR=60
100 REM LICHT
110 LX=120:LY=-100:LZ=-100
120 FOR Y=25 TO 170
130 FOR X=80 TO 270
140 RX=X-170
150 RY=Y-100
160 RZ=200
170 TMIN=9999:OBJ=0
180 GOSUB 500:REM   ' Kugel 1 testen
190 GOSUB 600:REM   ' Kugel 2 testen
200 IF OBJ=0 THEN PSET X,Y,0:GOTO 350
210 IX=CX+RX*TMIN
220 IY=CY+RY*TMIN
230 IZ=CZ+RZ*TMIN
240 IF OBJ=1 THEN SX=XS:SY=YS:SZ=ZS:SR=RS
250 IF OBJ=2 THEN SX=XX:SY=TY:SZ=ZZ:SR=RR
260 NX=(IX-SX)/SR
270 NY=(IY-SY)/SR
280 NZ=(IZ-SZ)/SR
290 DX=LX-IX:DY=LY-IY:DZ=LZ-IZ
300 DL=SQR(DX*DX+DY*DY+DZ*DZ)
310 IF DL=0 THEN DL=1
320 DX=DX/DL:DY=DY/DL:DZ=DZ/DL
330 LIGHT=NX*DX+NY*DY+NZ*DZ
340 IF LIGHT<0 THEN LIGHT=0
345 REM SCHATTEN
346 SH=1
347 XR=DX:YY=DY:TZ=DZ
348 GX=IX+NX*2:GY=IY+NY*2:CC=IZ+NZ*2
349 GOSUB 700
350 IF HIT=1 THEN SH=1
351 CL=INT(LIGHT*SH*11)
352 IF CL<=0 THEN CL=0:GOTO 355
353 CL=CL+RND(1)
354 IF CL>9 THEN CL=10
355 PSET X,Y,F(CL)
400 NEXT X
410 NEXT Y
420 END
500 REM KUGEL 1
510 SX=XS:SY=YS:SZ=ZS:SR=RS:ID=1
520 GOSUB 800
530 RETURN
600 REM KUGEL 2
610 SX=XX:SY=TY:SZ=ZZ:SR=RR:ID=2
620 GOSUB 800
630 RETURN
700 REM SCHATTEN-TEST (BEIDE KUGELN)
710 HIT=0
720 SX=XS:SY=YS:SZ=ZS:SR=RS
730 GOSUB 900
740 IF HIT=1 THEN RETURN
750 SX=XX:SY=TY:SZ=ZZ:SR=RR
760 GOSUB 900
770 RETURN
800 REM RAY-SPHERE INTERSECTION
810 A=RX*RX+RY*RY+RZ*RZ
820 B=2*(RX*(CX-SX)+RY*(CY-SY)+RZ*(CZ-SZ))
830 C=((CX-SX)^2)+((CY-SY)^2)+((CZ-SZ)^2)-(SR*SR)
840 D=B*B-4*A*C
850 IF D<0 THEN RETURN
860 T=(-B-SQR(D))/(2*A)
870 IF T>0 AND T<TMIN THEN TMIN=T:OBJ=ID
880 RETURN
900 REM SHADOW RAY
910 A=XR*XR+YY*YY+TZ*TZ
920 B=2*(XR*(GX-SX)+YY*(GY-SY)+TZ*(CC-SZ))
930 C=((GX-SX)^2)+((GY-SY)^2)+((CC-SZ)^2)-(SR*SR)
940 D=B*B-4*A*C
950 IF D>0 THEN HIT=1
960 RETURN
1000 PEN 0:PSET X,Y,0
1100 RETURN
