10 CUR0:COL 8,0:CLS
20 RX=60:RY=20
30 H=100:G=1
35 PRINT AT(7,2);"optische Taeuschung 3D-Kegel"
36 PRINT AT(4,4);"in welche Richtung dreht der Kegel?"
40 CX=160:CY=70
50 FOR AN=0 TO 360 STEP 3
60 RECT 55,45,250,175,1
80 FOR I=0 TO 360 STEP 30
90 RA=I*PI()/180:RB=(I+30)*PI()/180
100 XA=RX*COS(RA+AN*PI()/180):YA=RY*SIN(RA+AN*PI()/180)
110 XB=RX*COS(RB+AN*PI()/180):YB=RY*SIN(RB+AN*PI()/180)
120 LINE CX+XA,CY+YA,CX+XB,CY+YB
130 LINE CX+XA,CY+YA,CX,CY+H
145 F=!F:IF F=1 THEN PEN 12:ELSE PEN F
150 NEXT I
155 PAUSE 50
160 NEXT AN
200 GOTO 50
