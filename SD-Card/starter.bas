10 COL 0,43:FONT 25:CUR0:CLS:RESTORE
20 PRINT AT(11,2);"* Programmstarter *"
25 PRINT AT(2,29);"u=up  d=down enter=start"
30 COL0,2:RECT 0,30,319,220,1
40 DIM NA$(20)
45 POS 1,5
50 FOR I=0 TO 16:READ NA$(I):PRINT NA$(I):NEXT I
60 Y=4:SWAP 0,Y*8,319,Y*8+7
70 K=INKEY:IF K=0 THEN GOTO 70
80 IF K=ASC("u") THEN GOSUB 500
90 IF K=ASC("d") THEN GOSUB 600
100 IF K=13 THEN GOTO 800
110 GOTO 70
500 SWAP 0,Y*8,319,Y*8+7:Y=Y-1
510 IF Y<4 THEN Y=4
520 SWAP 0,Y*8,319,Y*8+7:RETURN
600 SWAP0,Y*8,319,Y*8+7:Y=Y+1
610 IF Y>20 THEN Y=20
620 SWAP0,Y*8,319,Y*8+7:RETURN
800 A$=NA$(Y-4)+".bin"
810 POS 10,27
820 RUN A$
900 END
1000 DATA "Altair8800","CPM","CPC","ESP81","Invaders","KIM1","KILO","GAMES"
1100 DATA "GAMEBOY","PACMAN","SCRLOADER","TELNET","WEBRADIO","ZXESP","VIC20"
1200 DATA "VECTREX","PLAYMP3"
